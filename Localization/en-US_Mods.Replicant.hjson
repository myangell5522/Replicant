# Replicant — English text.
# tModLoader adds any missing keys here automatically after a build.

NPCs: {
	Re.DisplayName: Re
	Requiem.DisplayName: Requiem
	Refrain.DisplayName: Refrain
	RecursionHead.DisplayName: Recursion
	RecursionBody.DisplayName: Recursion
	RecursionTail.DisplayName: Recursion
}

Items: {
	SealedVerse: {
		DisplayName: Sealed Verse
		Tooltip:
			'''
			A black tablet, warm to the touch
			Something inside it is still trying to finish a sentence
			Summons Re
			'''
	}

	CrackedVerse: {
		DisplayName: Cracked Verse
		Tooltip:
			'''
			[Testing] Brings Re to its last breath and starts the riddle immediately
			Single player only
			'''
	}

	FrayedVerse: {
		DisplayName: Frayed Verse
		Tooltip:
			'''
			[Testing] Opens the dimension (when InnoVault allows it) and wakes Requiem and Refrain
			While they fight, skips their song ahead to the next story beat
			In the true fight: calls the Aria, then the Intrusion, then fells Requiem (Refrain's frenzy)
			With one sister left: fells her (the third verse begins)
			Against Recursion: drops it to its next threshold (rewind, execute, death)
			Single player only
			'''
	}
}

