Recursion: {
	NotDone: WE'RE NOT DONE YET.
	Title: RECURSION
	Sub: The Verse That Devours
	Verse: — the third verse —
	Rewind: << REWIND
	Execute: EXECUTE.

	Lines: {
		# a = Requiem, b = Refrain
		Pleaa: ...No. Not you. Not after everything—
		Pleab: Wait— no, no, I sang! I sang everything you asked—!
	}
}

Bestiary: {
	Re: A shade of black slime that wears glyphs like scars. It remembers being someone. It does not remember who.
	Requiem: The elder of two sisters written out of Re's remains. She sings slowly, so that nothing is forgotten.
	Refrain: The younger sister. She sings the same song twice, in case the first time wasn't heard.
}

TitleCard.Subtitle: The Shade That Remembers

Riddle: {
	Question:
		'''
		I wear the face of someone you lost.
		I speak with a voice that was never mine.
		Strike me down, and you strike down the one you came to save.
		What am I?
		'''
	Answer0: A shadow.
	Answer1: A puppet.
	Answer2: A memory.
	Answer3: A Gestalt.
	Answer4: Your reflection.
	# Response0 is used when the correct answer is picked, Response1..4 for wrong picks (by pick number),
	# Response6 always closes the riddle after the fifth pick.
	Response0: ...Yes. And still, you raise your blade.
	Response1: No. Look closer.
	Response2: No. You are not listening.
	Response3: No. Is that what you tell yourself?
	Response4: No... Does it even matter?
	Response5: Nothing you choose will undo what you have done.
	Response6: It never mattered which one you chose.
}

Configs: {
	ReClientConfig: {
		DisplayName: Replicant — Visuals

		ScreenShake: {
			Label: Screen shake
			Tooltip: Camera shake from Re's attacks and the death sequence.
		}

		FlashIntensity: {
			Label: Flash intensity
			Tooltip: Brightness of full-screen flashes (0 disables them).
		}

		SkipRiddleCutscene: {
			Label: Skip the riddle
			Tooltip: Skips the eyes and riddle, but still plays the final burst.
		}
	}
}

Twins: {
	Speaker0: Requiem
	Speaker1: Refrain
	Speaker2: Requiem & Refrain
	Speaker3: ???
	Parry: Parried
	ShelterHint: The Verdict is coming. Find the sanctuary of light — nothing outside it will be spared.
	VerdictDeath: "{0} was read aloud by the Verdict."
	HackDeath: "{0} was overwritten."
	ScoreDeath: "{0} lost the beat."

	Score: {
		Row: Row {0} / {1}
		Inverse: Inverse — press the opposite
		Fading: Fading — remember them
		Clean: Played!
		Broken: The score breaks
	}

	Hack: {
		Title: Intrusion
		Controls: WASD / arrows: move   ·   Space: dash   ·   firing is automatic
		Warning: HOST COMPROMISED
		HintMove: WASD / Arrows — move
		HintDash: Space / Shift / Right Click — dash through notes
		HintFire: You fire on your own at the core — hold Left Click to aim
		HintShell: Break the GOLD shell · BLACK blocks and dark notes can't be destroyed
		Target: > CORE <
		Header: INTRUSION // refrain.sys
		Win: Intrusion Reversed
		Lose: Overwritten
	}

	Epilogue: {
		Title: The First Verse Ends
		Sub: Something older is still listening.
	}

	Barks: {
		Requiem0: Listen closely.
		Requiem1: Again, from the top.
		Requiem2: Hold still. It is easier.
		Requiem3: Every note is for you.
		Requiem4: Softly now.
		Requiem5: Do you hear it? That is your name.
		Requiem6: We were made to sing this.
		Requiem7: Do not look away.
		Refrain0: Keep up!
		Refrain1: Faster, faster!
		Refrain2: Here — and here — and here!
		Refrain3: Dance with me!
		Refrain4: Too slow, too slow!
		Refrain5: Again! Again!
		Refrain6: Catch me if you can!
		Refrain7: Ha — you almost had it!
		GriefRequiem0: She was the better half of the song.
		GriefRequiem1: I will sing her part too.
		GriefRequiem2: You took the only thing I had.
		GriefRequiem3: Be quiet. Be still. Be gone.
		GriefRefrain0: Give her back!
		GriefRefrain1: I'll sing until you break!
		GriefRefrain2: Sister, sister, sister —
		GriefRefrain3: Why won't you just DIE?!
	}

	Lines: {
		Intro1: Sister... we're awake. Someone came all this way.
		Intro2: Then let us sing for them. It's the only thing we were made for.
		Intro3: Don't worry. It won't hurt for long. It never does.
		False1: You strike well. The song carries every blow.
		False2: Again! Again! ...Why won't you stop?
		False3: Have you noticed? Nothing you take from us stays taken.
		False4: Your numbers keep falling. Ours don't. Doesn't that frighten you?
		False5: Listen. The song is about to breathe.
		Reveal1: Did you think we could be killed by someone who doesn't remember us?
		Reveal2: Every wound you gave us... we were only writing it down.
		Reveal3: Now we will read it back to you.
		True1: This is our real voice!
		True2: There are no more rehearsals.
		True3: Keep up, keep up! The song is ending, can't you hear it?
		True4: If we are only copies... then whose grief is this?
		# a = Requiem, b = Refrain
		Falla: ...Refrain. Keep singing. Don't stop for me.
		Fallb: Ah... sister, I'm sorry... I couldn't hold the note...
		Griefa: ...Then I will finish the song for both of us.
		Griefb: No. No, no, no— you don't get to take her too!
		Last1a: So this is how the song ends... quietly.
		Last1b: It's so quiet without her...
		Last2: Remember us. Even if no one else does.
		Verdict: Hear the verdict. Hide, if you can.
		HackWin: You... wrote back into us?!
		ScoreWin: Hey! That's MY song!
		ScoreLose: Off-key. As I thought.
		HackLose: Your code tastes like rust.
		Epilogue1: ...So the song has ended.
		Epilogue2: You did well, little one. They sang for me, and you listened.
		Epilogue3: Come find me at the end of the verse. I have been waiting.
	}

	Attacks: {
		Movement: Movement
		Reprise: — reprise: the same song, sung truly —

		Intro: {
			Title: Requiem & Refrain
			Sub: Two voices written out of one wound
		}

		Awakening: {
			Title: The True Song
			Sub: Every wound you gave them, read back to you
		}

		Lullaby: {
			Title: Lullaby of Ash
			Sub: Arms of light unwinding from the staff — gold breaks, black does not
		}

		Bells: {
			Title: Seven Bells
			Sub: Each bell rings a circle closed. Find the one way through
		}

		Verse: {
			Title: Verse Unbound
			Sub: Lines of scripture cut the air, and slowly turn
		}

		OilRain: {
			Title: Black Rain
			Sub: Oil falls from a sky that is not there
		}

		EchoDash: {
			Title: Echo
			Sub: Every step she takes is taken twice
		}

		Score: {
			Title: The Score
			Sub: Five lines, and every note is played at you
		}

		Canon: {
			Title: Canon
			Sub: A phrase in gold, answered in black
		}

		Glissando: {
			Title: Glissando
			Sub: She runs the length of the sky, shedding petals
		}

		DuetBeam: {
			Title: Duet
			Sub: A single note held between two voices. Stay in the silence
		}

		LyricWall: {
			Title: Lyric Wall
			Sub: Black verses must be passed; gold verses can be cut
		}

		LilyStorm: {
			Title: Lily Requiem
			Sub: The field answers their song
		}

		Aria: {
			Title: Aria
			Sub: The sky opens. Nothing beneath it is safe but the sanctuary
		}

		Intrusion: {
			Title: Intrusion
			Sub: She reaches inside you
		}

		FrenzyRequiem: {
			Title: Requiem Without End
			Sub: She will finish the song alone
		}

		FrenzyRefrain: {
			Title: Refrain Without End
			Sub: She sings it again, and again, and again
		}
	}
}
